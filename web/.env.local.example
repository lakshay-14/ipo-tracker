# Copy this file to .env.local and fill in your own values.

# Public: safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret: server only. Never add NEXT_PUBLIC_ to these.
SUPABASE_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
# Any random string of letters, numbers, _ or - (you make this up).
TELEGRAM_WEBHOOK_SECRET=
